<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" cacheDirectory="/tmp/.phpunit.cache"
         processIsolation="true" displayDetailsOnTestsThatTriggerWarnings="true">
  <testsuites>
    <testsuite name="altered">
      <directory suffix="Test.php">tests</directory>
      <!-- replays run without process isolation: phpunit-replay.xml -->
      <exclude>tests/ReplayTest.php</exclude>
    </testsuite>
  </testsuites>
</phpunit>
